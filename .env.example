# ---------------------------------------------------------------------------
# Supabase (required for auth, accounts and everything data-backed)
# Project Settings -> API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the trading engine and cron jobs. Never expose to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used to build auth redirect URLs.
# Local: http://localhost:3000
# Production: https://trenchleague.lol
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Market data (server-only — phase 2)
# ---------------------------------------------------------------------------
# Birdeye: token overview, OHLCV candles, trending, holders.
BIRDEYE_API_KEY=

# Helius: holder lists / metadata / RPC.
HELIUS_API_KEY=

# Jupiter: quotes + prices.
JUPITER_API_KEY=

# PumpPortal: live new launches (free) and per-mint trade streams (metered).
PUMPPORTAL_API_KEY=

# ---------------------------------------------------------------------------
# Paper trading engine
# ---------------------------------------------------------------------------
# Swap fee in basis points. 100 = 1%.
SWAP_FEE_BPS=100

# Fixed priority fee in SOL added to every fill.
PRIORITY_FEE_SOL=0.001

# ---------------------------------------------------------------------------
# Calls
# ---------------------------------------------------------------------------
# Bearer token for GET /api/cron/calls, so a scheduler can score rounds with
# nobody on the site. Leave empty to keep that route disabled — the Calls board
# already settles and opens rounds while it is being polled.
CRON_SECRET=
